+    /**
+     * Legacy code can still query decoded values through MySQL DECODE().
+     * After the transition script converted affected values, the raw value is already readable.
+     */
+    private function normalizeLegacyOxconfigDecodeQuery($query)
+    {
+        if (stripos($query, 'DECODE') === false) {
+            return $query;
+        }
+
+        $legacyDecodeColumns = [
+            'oxconfig' => 'oxvarvalue',
+            'oxuserpayments' => 'oxvalue',
+        ];
+
+        foreach ($legacyDecodeColumns as $tableName => $columnName) {
+            if (stripos($query, $tableName) !== false) {
+                $query = preg_replace(
+                    '/\bDECODE\s*\(\s*((?:`?\w+`?\.)?`?' . $columnName . '`?)\s*,\s*(\'[^\']*\'|"[^"]*")\s*\)/i',
+                    '$1',
+                    $query
+                );
+            }
+        }
+
+        return $query;
+    }
 
